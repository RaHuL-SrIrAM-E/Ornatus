# Copy to .env and adjust as needed. All variables are optional — see
# ornatus/config/settings.py for defaults.

ORNATUS_MODEL_PROVIDER=bedrock
ORNATUS_BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
ORNATUS_BEDROCK_REGION=us-west-2
ORNATUS_DB_PATH=ornatus.db
ORNATUS_LOG_LEVEL=INFO

# Bedrock auth is picked up from the standard AWS credential chain
# (e.g. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE), not from
# Ornatus-specific settings.
